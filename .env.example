# AutoScene backend environment — copy to .env and fill in. NEVER commit .env.

# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
# JSON array; MUST include your Vercel frontend domain
CORS_ORIGINS=["https://your-app.vercel.app","https://autoscene.app"]

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Optional: Fernet secret for per-user voice API keys (defaults to a key derived from SUPABASE_JWT_SECRET)
APP_ENCRYPTION_KEY=
SUPABASE_ANON_KEY=

# ── Redis (set by docker-compose in prod; localhost for bare-metal dev) ───────
REDIS_URL=redis://redis:6379/0

# ── AI providers ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
MINIMAX_API_KEY=
# eleven_flash_v2_5 (fast+cheap) | eleven_multilingual_v2 (higher quality)
ELEVENLABS_MODEL=eleven_flash_v2_5

# ── Image provider ───────────────────────────────────────────────────────────
# "gemini" (Google Nano Banana) = native character-lock from a reference image.
# Requires GOOGLE_AI_API_KEY; without it the code falls back to Stability SDXL
# (which does NOT use the reference image, so character lock is lost).
IMAGE_PROVIDER=gemini
GOOGLE_AI_API_KEY=

# ── Stability AI (SDXL — fallback image engine) ──────────────────────────────
STABILITY_API_KEY=
STABILITY_STEPS=40

# ── Backblaze B2 ─────────────────────────────────────────────────────────────
BACKBLAZE_KEY_ID=
BACKBLAZE_APPLICATION_KEY=
BACKBLAZE_BUCKET_NAME=
BACKBLAZE_BUCKET_ID=
BACKBLAZE_ENDPOINT_URL=
BACKBLAZE_REGION=

# ── Lemon Squeezy ────────────────────────────────────────────────────────────
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Fill after creating the 5 subscription products in the LS dashboard
LEMONSQUEEZY_STARTER_VARIANT_ID=
LEMONSQUEEZY_CREATOR_VARIANT_ID=
LEMONSQUEEZY_SCALE_VARIANT_ID=
LEMONSQUEEZY_CREATOR_M2_VARIANT_ID=
LEMONSQUEEZY_SCALE_M2_VARIANT_ID=

# ── Optional tuning ──────────────────────────────────────────────────────────
# SCENE_RENDER_CONCURRENCY=4
# SCENE_TRANSITION=fade
# SCENE_TRANSITION_MAX_SCENES=40
# SENTRY_DSN=
